<!DOCTYPE html>
<html>
<head>
    <title>Phiếu đăng ký tham gia chương trình khuyến mãi</title>
</head>

<body>

<form id="form1">

<table border="1" cellpadding="4" cellspacing="0"
       align="center">

    <tr>
        <td>Họ và tên</td>
        <td>
            <input type="text" id="hoTen" size="35">
        </td>
    </tr>

    <tr>
        <td>Địa chỉ</td>
        <td>
            <input type="text" id="diaChi" size="30">
        </td>
    </tr>

    <tr>
        <td>Điện thoại</td>
        <td>
            <input type="text" id="dienThoai" size="20">
        </td>
    </tr>

    <tr>
        <td>Phái</td>
        <td>
            <input type="radio" name="phai" id="nam" value="Nam">
            Nam
            <input type="radio" name="phai" id="nu" value="Nữ" checked>
            Nữ
        </td>
    </tr>

    <tr>
        <td>Nghề nghiệp</td>
        <td>
            <select id="ngheNghiep">
                <option value="Bác sĩ">Bác sĩ</option>
                <option value="Kỹ sư">Kỹ sư</option>
                <option value="Giáo viên" selected>Giáo viên</option>
                <option value="Khác">Khác</option>
            </select>
        </td>
    </tr>

    <tr>
        <td>Chọn sản phẩm tham gia</td>
        <td>
            <select id="sanPham" size="4" multiple>
                <option value="Kem đánh răng">Kem đánh răng</option>
                <option value="Bột giặt">Bột giặt</option>
                <option value="Dầu gội đầu">Dầu gội đầu</option>
                <option value="Sữa tắm">Sữa tắm</option>
            </select>
        </td>
    </tr>

    <tr>
        <td>Số người dự đoán tham gia</td>
        <td>
            <input type="text" id="soNguoi">
        </td>
    </tr>

    <tr>
        <td colspan="2" align="center">
            <input type="button"
                   id="dongY"
                   value="Đồng ý"
                   onclick="hienThi()">
        </td>
    </tr>

    <tr>
        <td colspan="2" align="center">
            <div id="nhan"></div>
        </td>
    </tr>

</table>

</form>

<script>
function hienThi() {
    document.getElementById("nhan").innerText =
        "Bạn đã đăng ký thành công!!!";
}
</script>

</body>
</html> 
